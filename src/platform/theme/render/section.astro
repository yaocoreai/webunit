---
import type { DocumentRenderPayload, SectionInstance } from '@/platform/theme/render/model';
import { readRenderRuntime } from '@/platform/theme/render/context';
const { value, payload } = Astro.props as { value: SectionInstance; payload: DocumentRenderPayload };
const { sectionRenders } = await import('@/platform/generated/theme/render-runtime');
const loader = sectionRenders[value.key as keyof typeof sectionRenders];
if (!loader) return;
const Section = (await loader()).default;
const context = readRenderRuntime(Astro.locals)?.context;
const templatePreview = context?.environment === 'editor-preview'
  && context.preview.type === 'template'
  ? context.preview
  : undefined;
const editing = templatePreview !== undefined;
const selected = editing && templatePreview.activeSection === value.id;
let label = value.key;
if (selected) {
  label = (await (await import('./definition-metadata')).loadSectionLabel(value.key)) ?? label;
}
---
{editing ? (
  <div class:list={['cms-render-section', { 'cms-render-section--selected': selected }]} data-cms-section={value.id}>
    <Section section={value} payload={payload} />
    {selected && <span class="cms-render-section__label">{label}</span>}
  </div>
) : (
  <Section section={value} payload={payload} />
)}

<style is:inline>
  .cms-render-section {
    position: relative;
  }

  .cms-render-section--selected::after {
    position: absolute;
    z-index: 2147483647;
    inset: 0;
    border: 3px solid #ef4444;
    pointer-events: none;
    content: '';
  }

  .cms-render-section__label {
    position: absolute;
    z-index: 2147483647;
    top: 0;
    right: 0;
    box-sizing: border-box;
    max-width: calc(100% - 4px);
    padding: 0.25rem 0.5rem;
    overflow: hidden;
    border-radius: 0 0 0 0.25rem;
    background: #ef4444;
    color: #fff;
    font: 600 0.75rem/1.25 ui-sans-serif, system-ui, sans-serif;
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
  }
</style>
