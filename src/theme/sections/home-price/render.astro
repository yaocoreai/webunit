---
import { useSection } from '@/platform/theme';
import type { HomePriceSection } from '@/platform/theme';
import { href, siteLocale } from '@/theme/path';
import Link from '@/theme/partials/link/render.astro';

const { locale: requested, settings } = useSection<HomePriceSection>(Astro);
const locale = siteLocale(requested);
const home = settings;
---
<section class="bg-white">
  <div class="mx-auto max-w-[980px] px-6 py-20 text-center">
    <h2 class="font-display text-[40px] font-semibold leading-[1.1]">{home.priceTitle}</h2>
    <p class="mx-auto mt-3 max-w-xl text-[17px] text-muted">{home.priceNote}</p>
    <table class="mx-auto mt-10 w-full max-w-xl border-collapse">
      <caption class="sr-only">{home.priceTitle}</caption>
      <thead>
        <tr class="border-b border-ink text-[12px] text-muted">
          <th scope="col" class="whitespace-nowrap px-1 py-3 font-normal min-[480px]:px-4">{home.priceColumns.client}</th>
          <th scope="col" class="whitespace-nowrap px-1 py-3 font-normal min-[480px]:px-4">{home.priceColumns.day}</th>
          <th scope="col" class="whitespace-nowrap px-1 py-3 font-normal min-[480px]:px-4">{home.priceColumns.month}</th>
        </tr>
      </thead>
      <tbody class="tabular-nums">
        {home.priceRows.map((row, index) => (
          <tr class={index === 0 ? 'border-b border-hairline' : undefined}>
            <th scope="row" class="whitespace-nowrap px-1 py-6 text-[17px] font-normal min-[480px]:px-4 min-[480px]:text-[21px]">{row.client}</th>
            <td class="whitespace-nowrap px-1 py-6 text-[20px] font-semibold min-[480px]:px-4 min-[480px]:text-[28px]">{row.day}</td>
            <td class="whitespace-nowrap px-1 py-6 text-[20px] font-semibold min-[480px]:px-4 min-[480px]:text-[28px]">{row.month}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-8"><Link class="text-primary" href={href(locale, home.priceMore.href)}>{home.priceMore.label}</Link></p>
  </div>
</section>
