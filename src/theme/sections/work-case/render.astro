---
import { useSection } from '@/platform/theme';
import type { WorkCaseSection } from '@/platform/theme';
import { href, siteLocale } from '@/theme/path';
import Image from '@/theme/partials/image/render.astro';
import Link from '@/theme/partials/link/render.astro';
import Placeholder from '@/theme/partials/placeholder/render.astro';

const { locale: requested, settings } = useSection<WorkCaseSection>(Astro);
const locale = siteLocale(requested);
const work = settings;
const caption = settings.placeholderCaption;
const headed = work.h1.trim() !== "";
---
<article class:list={["mx-auto max-w-[980px] px-6", headed ? "pb-4 pt-20 min-[834px]:pt-24" : "pb-20"]}>
  {headed && (
    <>
      <p class="text-center text-[12px] text-muted">{work.mask}</p>
      <h1 class="mt-3 text-center font-display text-[40px] font-semibold leading-[1.07] tracking-[-0.28px] min-[1069px]:text-[56px]">{work.h1}</h1>
      <p class="mx-auto mt-5 max-w-xl text-center text-[21px] font-normal leading-[1.29]">{work.lead}</p>
    </>
  )}
  <div class:list={["grid items-start gap-8 border-t border-hairline pt-10 min-[834px]:grid-cols-[0.9fr_1.1fr] min-[834px]:items-stretch", headed ? "mt-12" : "mt-4"]}>
    {work.image.file ? (
      <Image class="min-h-64 w-full object-cover min-[834px]:h-full" asset={work.image.file} alt={work.image.label} width={work.image.file.width} height={work.image.file.height} />
    ) : (
      <Placeholder label={work.image.label} caption={caption} className="min-[834px]:h-full" />
    )}
    <div>
      <h2 class="text-[28px] font-semibold tracking-[-0.28px]">{work.name}</h2>
      <p class="mt-3 text-[17px] leading-[1.47]">{work.summary}</p>
      <dl class="mt-6">
        {work.facts.map((fact) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-3 border-b border-hairline py-3 text-[14px]">
            <dt class="text-muted">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
  <h2 class="mt-14 text-[28px] font-semibold tracking-[-0.28px]">{work.storyTitle}</h2>
  <p class="mt-4 max-w-[40rem]">{work.story}</p>
  {work.quote.trim() !== "" && (
    <blockquote class="mt-8 max-w-[40rem] border-l-2 border-ink pl-4 text-[19px] leading-[1.2] tracking-[-0.21px]">{work.quote}</blockquote>
  )}
  <p class="mt-8"><Link href={href(locale, work.more.href)} class="text-primary">{work.more.label}</Link></p>
</article>
