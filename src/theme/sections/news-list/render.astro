---
import { useSection } from '@/platform/theme';
import type { NewsListSection } from '@/platform/theme';
import type { ArticleEntry } from '@/theme/types';
import { href, siteLocale } from '@/theme/path';
import Image from '@/theme/partials/image/render.astro';
import Link from '@/theme/partials/link/render.astro';
import Placeholder from '@/theme/partials/placeholder/render.astro';

const { locale: requested, settings, content } = useSection<NewsListSection>(Astro);
const locale = siteLocale(requested);
const articles = (await content.module<ArticleEntry>('article').findMany({
  orderBy: [{ path: 'fields.order', direction: 'asc' }],
  limit: 20,
})).items;
---
<div class="mx-auto max-w-[980px] px-6 pb-20 pt-20 min-[834px]:pt-24">
  <p class="text-center text-[12px] tracking-[-0.12px] text-muted">{settings.studio}</p>
  <h1 class="font-display mt-3 text-center text-[40px] font-semibold leading-[1.07] tracking-[-0.28px] min-[1069px]:text-[56px]">{settings.h1}</h1>
  <p class="mx-auto mt-5 max-w-xl text-center text-[21px] font-normal leading-[1.29]">{settings.lead}</p>
  <ul class="mt-14">
    {articles.map((article) => (
      <li class="border-t border-hairline">
        <Link class="grid gap-5 py-6 min-[834px]:grid-cols-[220px_1fr] min-[834px]:items-center" href={href(locale, article.page?.path ?? '')}>
          {article.fields.image ? (
            <Image class="h-28 w-full object-cover" asset={article.fields.image} alt={article.fields.title} width={220} height={112} />
          ) : (
            <Placeholder label={article.fields.image_label ?? ''} caption={settings.placeholderCaption} size="row" />
          )}
          <span>
            <span class="block text-[21px] font-semibold leading-[1.19] tracking-[0.231px]">{article.fields.title}</span>
            <span class="mt-2 block text-muted">{article.fields.description}</span>
          </span>
        </Link>
      </li>
    ))}
  </ul>
</div>
