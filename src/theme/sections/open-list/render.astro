---
import { useSection } from '@/platform/theme';
import type { OpenListSection } from '@/platform/theme';
import Link from '@/theme/partials/link/render.astro';
import Placeholder from '@/theme/partials/placeholder/render.astro';

const { settings } = useSection<OpenListSection>(Astro);
const open = settings;
const caption = settings.placeholderCaption;
---
<article class="mx-auto max-w-[980px] px-6 pb-20 pt-20 min-[834px]:pt-24">
  <h1 class="text-center font-display text-[40px] font-semibold leading-[1.07] tracking-[-0.28px] min-[1069px]:text-[56px]">{open.h1}</h1>
  <p class="mx-auto mt-5 max-w-xl text-center text-[21px] font-normal leading-[1.29]">{open.lead}</p>
  <ul class="mt-12 grid gap-16">
    {open.items.map((item) => (
      <li class="border-t border-hairline pt-10">
        <div class="grid items-start gap-8 min-[834px]:grid-cols-[0.9fr_1.1fr] min-[834px]:items-center">
          <Placeholder label={item.image.label} caption={caption} className="!min-h-44 min-[834px]:!h-full min-[834px]:!min-h-56" />
          <div>
            <p class="text-[12px] text-muted">{item.status}</p>
            <h2 class="mt-3 text-[28px] font-semibold tracking-[-0.28px]">{item.name}</h2>
            <p class="mt-4">{item.detail}</p>
            {item.repository?.href ? <p class="mt-4"><Link class="text-primary" href={item.repository.href} target="_blank" rel="noopener noreferrer">{item.repository.label}</Link></p> : null}
          </div>
        </div>
        <dl class="mt-10 border-t border-hairline">
          {item.points.map((point) => (
            <div class="grid gap-1 border-b border-hairline py-4 min-[834px]:grid-cols-[11rem_1fr] min-[834px]:items-baseline min-[834px]:gap-8">
              <dt class="font-semibold">{point.label}</dt>
              <dd>{point.text}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ul>
</article>
